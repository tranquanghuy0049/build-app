# OpenAI API Key - get yours at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-api-key-here

# Groq API Key (free) - get yours at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here

# Whisper provider: "openai", "groq", or "phowhisper"
WHISPER_PROVIDER=openai

# PhoWhisper model (only used when WHISPER_PROVIDER=phowhisper)
# Options: vinai/PhoWhisper-tiny, vinai/PhoWhisper-base, vinai/PhoWhisper-small, vinai/PhoWhisper-medium
PHOWHISPER_MODEL=vinai/PhoWhisper-small