# API keys
.env

# Python
__pycache__/
*.pyc
*.pyo
venv/
# PyInstaller specs it generates itself, but ours is checked in — CI builds from it.
*.spec
!meeting_summarizer/packaging/*.spec

# Build outputs
build/
dist/

# Speech model weights staged at build time by packaging/fetch_model.py.
# Hundreds of MB — fetched during CI, never committed.
meeting_summarizer/models/

# Contains a real .env; never distribute or commit it.
meeting_summarizer/meeting_summarizer.zip

# Meeting outputs
meeting_summarizer/meeting_outputs/

# OS
Thumbs.db
.DS_Store
